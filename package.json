{
  "name": "grimoire-books",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@grimoire/web' --filter '@grimoire/server' dev",
    "dev:desktop": "bun run --cwd apps/desktop dev:hmr",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "bun run --cwd apps/server build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "start:server": "bun run --cwd apps/server start",
    "storybook": "bun run --cwd apps/web storybook",
    "build:storybook": "bun run --cwd apps/web build-storybook",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "db:wipe": "bun run scripts/wipe-db.ts",
    "docs:check": "okq --bundle docs validate && okq --bundle docs deadlinks && okq --bundle docs lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@grimoire/core": "workspace:*"
  }
}
